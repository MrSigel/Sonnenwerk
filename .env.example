# ── E-Mail (Resend) ────────────────────────────────────────────────
# Server-seitig, niemals im Client
RESEND_API_KEY=
# Absenderadresse (muss zur in Resend verifizierten Domain gehören), z. B.:
# Sonnenwerk <anfrage@strom-distributor.de>
MAIL_FROM=
# Empfänger der Lead-Benachrichtigungen, z. B. office@strom-distributor.de
LEAD_RECIPIENT=

# ── Seite / Newsletter-DOI ─────────────────────────────────────────
# Öffentliche Basis-URL (für Links in E-Mails), z. B. https://sonnenwerk.de
NEXT_PUBLIC_SITE_URL=
# Langer Zufallswert zum Signieren der Double-Opt-in-Tokens
DOI_SECRET=

# ── Meta-Pixel (lädt erst nach Consent, §15) ───────────────────────
# Haupt-Pixel: liegt auf allen Seiten (inkl. Startseite), sendet PageView.
NEXT_PUBLIC_META_PIXEL_ID=
# Zweiter Pixel: feuert ausschließlich auf der Danke-Seite (/danke).
NEXT_PUBLIC_META_PIXEL_ID_DANKE=

# ── Bitrix / LIMITBREAKERS Lead-Webhook (n8n) ──────────────────────
# Der Token steckt bereits im Pfad, keine zusätzliche Auth nötig.
# Test-Hook (nur 1 Lead, danach deaktiviert): https://api.bvd-ug.de/webhook-test/Import-LP-V1
# Produktiv (Workflow muss aktiv sein):        https://api.bvd-ug.de/webhook/Import-LP-V1
BITRIX_WEBHOOK_URL=

# ── Optional: verteiltes Rate-Limiting (§16); leer = In-Memory-Fallback ─
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Analytics-Bereich /admin ────────────────────────────────────
# Passwort fuer den Login unter /admin. Nur in Vercel setzen, nie hier eintragen.
ADMIN_PASSWORD=
# Speicher fuer die anonymen Nutzungszaehler (kostenloser Upstash-Tarif genuegt).
# Dieselben Variablen werden auch fuers Rate-Limiting genutzt.
